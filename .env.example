# Optional persistent SQLite directory. Render disk example: /var/data/depshield
# DEPSHIELD_DATA_DIR=/var/data/depshield

# Advanced feature flags. Core analysis remains usable when the optional AI
# provider is absent. Keep Attack Replay off on every public deployment.
ENABLE_AI_ANALYST=true
ENABLE_REACHABILITY=true
ENABLE_REMEDIATION_SANDBOX=true
ENABLE_POLICY_ENGINE=true
ENABLE_ATTACK_REPLAY=false
# Project-folder mode sends bounded JavaScript/TypeScript source to this server.
# Enable only for local or trusted private deployments; production defaults off.
ENABLE_SOURCE_UPLOADS=true

# Per-process safety bound for expensive npm audit jobs (1-8).
DEPSHIELD_MAX_CONCURRENT_SCANS=2

# Reserved normalized-provider flags. This build records NVD/GitHub as skipped
# because authenticated adapters are not implemented; enabling these flags does
# not fabricate provider coverage.
ENABLE_NVD_PROVIDER=false
ENABLE_GITHUB_ADVISORY_PROVIDER=false

# Recommended Google Gemini enhancement for DepShield Analyst. The key is a
# server-only secret: never prefix it with NEXT_PUBLIC_ or commit a real value.
# Without a key, the evidence-cited deterministic analyst remains available.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional custom OpenAI-compatible provider. Gemini takes precedence when both
# keys are configured; these values remain available for backwards compatibility.
# DEPSHIELD_AI_API_KEY=
# DEPSHIELD_AI_BASE_URL=https://api.openai.com/v1
# DEPSHIELD_AI_MODEL=gpt-4o-mini
